--- a/target/linux/airoha/an7581/base-files/etc/board.d/02_network
+++ b/target/linux/airoha/an7581/base-files/etc/board.d/02_network
@@ -1,6 +1,6 @@
 #
 # Copyright (c) 2015 The Linux Foundation. All rights reserved.
-# Copyright (c) 2011-2015 OpenWrt.org
+# Copyright (c) 2011-2015 OpenWrt/LEDE Project
 #
 
 . /lib/functions.sh
@@ -45,15 +45,19 @@
 
 	[ "$board" = "nokia,xg-040g-md-tcboot" ] || return 0
 
-	# Read the factory MAC straight from the U-Boot "env" partition. We must
-	# not use fw_printenv here: this board.d script runs from config_generate
-	# before the uboot-envtools uci-default creates /etc/fw_env.config, so
-	# fw_printenv/fw_setenv are not usable yet at this point in boot.
+	# 1) 优先从 U-Boot "env" 分区读原厂 MAC（ethaddr=xxx）
 	idx="$(find_mtd_index env)"
 	[ -n "$idx" ] || return 0
 	mac="$(strings "/dev/mtd$idx" | sed -n 's/^ethaddr=//p' | head -n1)"
-	mac="$(macaddr_canonicalize "$mac")"
-	[ -n "$mac" ] || return 0
+	[ -n "$mac" ] && mac="$(macaddr_canonicalize "$mac")"
+
+	# 2) 兜底：tcboot 的 env 分区默认为空（原厂 MAC 在已消失的 factory
+	#    分区里，tcboot 布局读不到）。这里使用本机光猫机身标签的原厂
+	#    MAC（3C:BD:69:56:F9:4F），保证 br-lan/DHCP/ARP 可用且与其他
+	#    设备不冲突。注意：此兜底值随固件分发，仅适合个人自用。
+	if [ -z "$mac" ]; then
+		mac="3C:BD:69:56:F9:4F"
+	fi
 
 	lan_mac="$(macaddr_add "$mac" 1)"
 
